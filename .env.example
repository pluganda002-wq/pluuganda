# MongoDB Atlas (or self-hosted) — paste your connection string in Vercel & local .env
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/plu_bot?retryWrites=true&w=majority

# Telegram bot (BotFather) — for webhook at /api/webhook or local bot/index.js
BOT_TOKEN=

# Public HTTPS URL of this app (Vercel deployment URL, no trailing slash)
WEB_APP_URL=https://your-project.vercel.app

# Optional: local dev only — Vite proxies /api to Vercel dev or leave empty on Vercel
# VITE_API_BASE=
