# =============================================================================
# PLU BOT — copy to .env (server) and .env.local (client + Vercel CLI)
# Never commit .env or .env.local. Run: npm run env:vercel (after VERCEL_* set)
# =============================================================================

# --- PLU core (server / Vercel functions) ---
MONGODB_URI=
MONGODB_DB_NAME=plu_bot
BOT_TOKEN=
WEB_APP_URL=https://pluuganda-hifl.vercel.app

# --- Auth & admin (server) ---
BYPASS_TELEGRAM_AUTH=
ACCESS_ADMIN=
ADMIN_PASSWORD=
ADMIN_ITEM_PASSWORD=
ADMIN_ITEM_PASSWORD_MITROPLUSLABS=
ADMIN_ITEM_PASSWORD_MANAGE_TASKS=

# --- Telegram & announcements ---
TELEGRAM_ANNOUNCEMENT_CHANNEL_ID=

# --- Backups & misc server ---
BACKUP_INCLUDE_SECRETS=
YOUR_ENV_VARIABLE=

# --- Payments & integrations (server) ---
# MTN MoMo Collections (Tugende wallet top-up) — https://momodeveloper.mtn.com/
MOMO_API_USER=
MOMO_API_KEY=
MOMO_SUBSCRIPTION_KEY=
MOMO_TARGET_ENVIRONMENT=sandbox
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
ADS_PAYMENT_WEBHOOK_SECRET=
YOGUPAY_LIVE=false
GAME_DB_OUTAGE_MODE=

# --- Client (Vite build — use NEXT_PUBLIC_ or VITE_ prefix) ---
NEXT_PUBLIC_BOT_USERNAME=
NEXT_PUBLIC_CHANNEL_LINK=
NEXT_PUBLIC_BYPASS_TELEGRAM_AUTH=
NEXT_PUBLIC_TON_ADS_RECEIVER_ADDRESS=

# Optional Vite aliases (same values as NEXT_PUBLIC_* if you prefer)
# VITE_BOT_USERNAME=
# VITE_CHANNEL_LINK=
# Local dev: leave empty — Tugende uses browser storage (no /api proxy). Or use production:
# VITE_API_BASE=https://pluuganda-hifl.vercel.app
# With npm run dev:api on port 3000, force Tugende to use the proxy:
# VITE_TUGENDE_USE_API=true
# Optional CARTO Basemaps (from carto.com/basemaps email — use ONE of these):
# Paste the full "Raster (PNG) tile URL" from the email (Leaflet / Tugende map):
# VITE_CARTO_RASTER_URL=https://basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png?key=YOUR_KEY
# Or paste only the key value:
# VITE_CARTO_API_KEY=
# "Vector style URL" is for MapLibre GL — not used by Tugende (Leaflet uses raster above).

# --- Vercel CLI (local only — do NOT upload VERCEL_TOKEN to Vercel) ---
VERCEL_TOKEN=
VERCEL_PROJECT_NAME=pluuganda
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
